---
import '@fontsource-variable/fredoka';
import '@fontsource/pacifico';
import '../styles/global.css';
import pacificoLatin from '@fontsource/pacifico/files/pacifico-latin-400-normal.woff2?url';
import fredokaLatin from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';
import { getCollection } from 'astro:content';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Bolsita from '../components/cart/Bolsita.tsx';
import { tienda } from '../config';
import { imagenProducto, url } from '../lib/utils';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = tienda.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${tienda.nombre}` : `${tienda.nombre} | ${tienda.lema}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.jpg'), Astro.site);

// Catálogo vigente: la bolsita lo usa para corregir precios guardados de visitas anteriores
const catalogo = Object.fromEntries(
  (await getCollection('productos')).map((p) => [
    p.id,
    {
      nombre: p.data.nombre,
      precio: p.data.precio,
      imagen: imagenProducto(p.data.imagen),
      color: p.data.color,
      disponible: p.data.disponible,
    },
  ]),
);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('icono-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content="#fff5f8" />
    <link rel="preload" href={pacificoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fredokaLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={tienda.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:font-semibold"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Bolsita client:only="preact" />
    <script type="application/json" id="catalogo-bolsita" set:html={JSON.stringify(catalogo).replace(/</g, '\\u003c')} />

    <script>
      import { agregar, sincronizarConCatalogo, type ProductoCatalogo } from '../lib/cart';

      // Corrige la bolsita guardada si cambiaron precios o se agotó algo desde la última visita
      try {
        const datos = document.getElementById('catalogo-bolsita')?.textContent;
        if (datos) sincronizarConCatalogo(JSON.parse(datos) as Record<string, ProductoCatalogo>);
      } catch {
        /* si falla, la bolsita queda como estaba */
      }

      // Botones "Agregar" del HTML estático (tarjetas y página de producto)
      document.addEventListener('click', (evento) => {
        const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
        if (!boton || boton.disabled) return;

        const { id, nombre, precio, imagen, color, cantidadDesde } = boton.dataset;
        if (!id || !nombre || !precio || !imagen) return;

        let cantidad = 1;
        if (cantidadDesde) {
          const campo = document.querySelector<HTMLInputElement>(cantidadDesde);
          cantidad = Math.max(1, Number.parseInt(campo?.value ?? '1', 10) || 1);
        }

        agregar({ id, nombre, precio: Number(precio), imagen, color }, cantidad);

        // Confirmación en el mismo botón
        const texto = boton.querySelector<HTMLElement>('[data-texto]');
        if (texto && !boton.dataset.ocupado) {
          const original = texto.textContent;
          boton.dataset.ocupado = '1';
          boton.classList.add('agregado');
          texto.textContent = '¡Agregado!';
          setTimeout(() => {
            texto.textContent = original;
            boton.classList.remove('agregado');
            delete boton.dataset.ocupado;
          }, 1400);
        }
      });
    </script>
  </body>
</html>
