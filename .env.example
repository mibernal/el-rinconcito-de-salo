# Copia este archivo como .env y llena los valores (el .env NO se sube a GitHub).
# Supabase → Project Settings → API Keys / Data API
#   PUBLIC_SUPABASE_URL: URL del proyecto, ej. https://xxxxxxxx.supabase.co
#   PUBLIC_SUPABASE_KEY: clave "publishable" (sb_publishable_…). Es pública por diseño;
#                        nunca pongas aquí la clave "secret" ni la "service_role".
# Si se dejan vacías, la página usa src/data/productos.yaml.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=
