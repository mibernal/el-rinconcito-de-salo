---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { CATEGORIAS, type Categoria } from '../content.config';
import { enlaceWhatsApp, mensajeSaludo } from '../lib/whatsapp';

interface Props {
  productos: CollectionEntry<'productos'>[];
}

const { productos } = Astro.props;

const filtros = [
  { valor: 'todo', texto: 'Todo', cantidad: productos.length },
  ...(Object.entries(CATEGORIAS) as [Categoria, string][])
    .map(([valor, texto]) => ({
      valor,
      texto,
      cantidad: productos.filter((p) => p.data.categoria === valor).length,
    }))
    .filter((f) => f.cantidad > 0),
];
---

<section id="catalogo" class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6" data-catalogo>
  <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <div>
      <h2 class="text-4xl font-semibold sm:text-5xl">Catálogo</h2>
      <p class="mt-2 max-w-prose text-tinta-suave">
        Agrega lo que te guste a tu bolsita y envía el pedido por WhatsApp.
      </p>
    </div>

    <label class="relative block w-full md:w-80">
      <span class="sr-only">Buscar productos</span>
      <Icon nombre="buscar" class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-tinta-suave" />
      <input
        type="search"
        data-buscador
        placeholder="Buscar: mascarilla, brillo…"
        autocomplete="off"
        class="h-12 w-full rounded-full border-2 border-pincel bg-white pl-12 pr-4 outline-none placeholder:text-tinta-suave/70 focus:border-fucsia"
      />
    </label>
  </div>

  <div
    role="group"
    aria-label="Filtrar por categoría"
    class="-mx-4 mt-6 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0"
  >
    {
      filtros.map((f) => (
        <button
          type="button"
          data-filtro={f.valor}
          aria-pressed={f.valor === 'todo' ? 'true' : 'false'}
          class="chip inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-4 py-2 font-medium shadow-[inset_0_0_0_2px_var(--color-pincel)] transition-colors hover:bg-pincel aria-pressed:bg-tinta aria-pressed:text-white aria-pressed:shadow-none"
        >
          {f.texto}
          <span class="text-sm tabular-nums opacity-60">{f.cantidad}</span>
        </button>
      ))
    }
  </div>

  <div class="mt-4 flex items-center justify-between gap-3 text-sm text-tinta-suave">
    <p aria-live="polite" data-conteo>{productos.length} productos</p>
    <label class="flex items-center gap-2">
      <span>Ordenar</span>
      <select
        data-orden
        class="rounded-full border-2 border-pincel bg-white py-1.5 pl-3 pr-8 font-medium text-tinta outline-none focus:border-fucsia"
      >
        <option value="">Recomendados</option>
        <option value="menor">Menor precio</option>
        <option value="mayor">Mayor precio</option>
      </select>
    </label>
  </div>

  <ul data-lista class="mt-5 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4" role="list">
    {productos.map((producto) => <ProductCard producto={producto} />)}
  </ul>

  <div data-vacio hidden class="mx-auto mt-6 max-w-md rounded-tile bg-rosa px-6 py-10 text-center">
    <p class="text-xl font-semibold">No encontramos “<span data-vacio-texto></span>”</p>
    <p class="mt-2 text-tinta-suave">Prueba con otra palabra o pregúntanos por WhatsApp: quizá lo conseguimos.</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <button type="button" data-limpiar class="btn btn-borde">Ver todo</button>
      <a href={enlaceWhatsApp(mensajeSaludo())} target="_blank" rel="noopener" class="btn btn-fucsia">
        <Icon nombre="chat" />
        Preguntar
      </a>
    </div>
  </div>
</section>

<script>
  import { normalizar } from '../lib/utils';

  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const chips = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const items = [...raiz.querySelectorAll<HTMLElement>('[data-producto]')];
    const buscador = raiz.querySelector<HTMLInputElement>('[data-buscador]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    const vacioTexto = raiz.querySelector<HTMLElement>('[data-vacio-texto]')!;
    const conteo = raiz.querySelector<HTMLElement>('[data-conteo]')!;
    const lista = raiz.querySelector<HTMLElement>('[data-lista]')!;
    const selectorOrden = raiz.querySelector<HTMLSelectElement>('[data-orden]')!;
    const ordenOriginal = [...items];
    const validas = new Set(chips.map((c) => c.dataset.filtro));

    const params = new URLSearchParams(location.search);
    let categoria = validas.has(params.get('categoria') ?? '') ? params.get('categoria')! : 'todo';
    buscador.value = params.get('q') ?? '';
    const ordenUrl = params.get('orden') ?? '';
    selectorOrden.value = ['menor', 'mayor'].includes(ordenUrl) ? ordenUrl : '';

    const ordenar = () => {
      const modo = selectorOrden.value;
      const precio = (el: HTMLElement) => Number(el.dataset.precio);
      const disp = (el: HTMLElement) => Number(el.dataset.disponible);
      const orden = modo
        ? [...ordenOriginal].sort(
            (a, b) => disp(b) - disp(a) || (modo === 'menor' ? precio(a) - precio(b) : precio(b) - precio(a)),
          )
        : ordenOriginal;
      lista.append(...orden);
    };

    const aplicar = () => {
      const q = normalizar(buscador.value);
      let visibles = 0;

      for (const item of items) {
        const enCategoria = categoria === 'todo' || item.dataset.categoria === categoria;
        const enBusqueda = !q || q.split(/\s+/).every((p) => item.dataset.buscar?.includes(p));
        item.hidden = !(enCategoria && enBusqueda);
        if (!item.hidden) visibles++;
      }

      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.filtro === categoria));
      }

      vacio.hidden = visibles > 0;
      vacioTexto.textContent = buscador.value.trim() || 'esa categoría';
      conteo.textContent = `${visibles} ${visibles === 1 ? 'producto' : 'productos'}`;

      const url = new URL(location.href);
      categoria === 'todo' ? url.searchParams.delete('categoria') : url.searchParams.set('categoria', categoria);
      q ? url.searchParams.set('q', buscador.value.trim()) : url.searchParams.delete('q');
      selectorOrden.value ? url.searchParams.set('orden', selectorOrden.value) : url.searchParams.delete('orden');
      history.replaceState(null, '', url);
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        categoria = chip.dataset.filtro ?? 'todo';
        aplicar();
      });
    }
    buscador.addEventListener('input', aplicar);
    selectorOrden.addEventListener('change', () => {
      ordenar();
      aplicar();
    });
    raiz.querySelector('[data-limpiar]')?.addEventListener('click', () => {
      categoria = 'todo';
      buscador.value = '';
      aplicar();
      buscador.focus();
    });

    if (selectorOrden.value) ordenar();
    if (categoria !== 'todo' || buscador.value || selectorOrden.value) aplicar();
  }
</script>
