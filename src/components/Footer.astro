---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { tienda } from '../config';
import { enlaceWhatsApp, mensajeSaludo } from '../lib/whatsapp';

const anio = new Date().getFullYear();
---

<footer class="bg-tinta text-white">
  <div class="mx-auto max-w-6xl px-4 pb-28 pt-14 sm:px-6 md:pb-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <Logo tono="claro" class="text-[2rem] sm:text-4xl" />
        <p class="mt-3 text-pincel">{tienda.lema}</p>
      </div>
      <ul class="flex flex-wrap gap-3">
        <li>
          <a
            href={enlaceWhatsApp(mensajeSaludo())}
            target="_blank"
            rel="noopener"
            class="btn bg-white text-tinta hover:bg-pincel"
          >
            <Icon nombre="chat" />
            Escríbenos por WhatsApp
          </a>
        </li>
        {
          tienda.instagram && (
            <li>
              <a
                href={`https://instagram.com/${tienda.instagram}`}
                target="_blank"
                rel="noopener"
                class="btn text-white shadow-[inset_0_0_0_2px_rgb(255_255_255/0.5)] hover:bg-white/10"
              >
                <Icon nombre="camara" />
                Instagram
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/15 pt-6 text-sm text-white/70 sm:flex-row sm:justify-between"
    >
      <p>© {anio} {tienda.nombre}</p>
      <p>Precios en pesos colombianos, sujetos a disponibilidad.</p>
    </div>
  </div>
</footer>
